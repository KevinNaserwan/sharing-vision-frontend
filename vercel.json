{
  "version": 2,
  "buildCommand": "",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/api/article",
      "destination": "https://be-sharing-vision.meetsin.id/article/"
    },
    {
      "source": "/api/article/",
      "destination": "https://be-sharing-vision.meetsin.id/article/"
    },
    {
