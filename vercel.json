{
  "version": 2,
  "buildCommand": "",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/api/article",
      "destination": "http://be-sharing-vision.meetsin.id:8000/article/"
    },
    {
      "source": "/api/article/",
      "destination": "http://be-sharing-vision.meetsin.id:8000/article/"
    },
    {
      "source": "/api/article/:path*",
      "destination": "http://be-sharing-vision.meetsin.id:8000/article/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "http://be-sharing-vision.meetsin.id:8000/:path*"
    }
  ]
}
